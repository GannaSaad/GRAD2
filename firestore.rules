rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================
    // Helper Functions
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && getRole() == "Admin";
    }
    
    function isDoctor() {
      return isSignedIn() && getRole() == "doctor";
    }
    
    function isPatient() {
      return isSignedIn() && getRole() == "patient";
    }
    
    // =========================
    // Users Collection
    // =========================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if
        isSignedIn() &&
        (request.auth.uid == userId ||
         isAdmin() ||
         (isDoctor() &&
          request.resource.data.role == "Receptionist"));
      allow update: if
        isSignedIn() &&
        (request.auth.uid == userId ||
         isAdmin() ||
         (isDoctor() &&
          resource.data.role == "Receptionist"));
      allow delete: if isAdmin();
    }
    
    // =========================
    // Reviews Collection
    // =========================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if
        isSignedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // =========================
    // Appointments
    // =========================
    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }
    
    // =========================
    // Doctor Availability
    // =========================
    match /availability/{docId} {
      allow read, write: if isSignedIn();
    }
    
    // =========================
    // Inventory
    // =========================
    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }
    
    // =========================
    // Supply Requests
    // =========================
    match /supplies_requests/{requestId} {
      allow read, write: if isSignedIn();
    }
    
    // =========================
    // Suppliers
    // =========================
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    
    // =========================
    // Medical Records
    // =========================
    match /medical_records/{recordId} {
      allow read, write: if isSignedIn();
    }
    
    // =========================
    // Support Tickets
    // =========================
    match /support_tickets/{ticketId} {
      allow read, write: if isSignedIn();
    }
  }
}
